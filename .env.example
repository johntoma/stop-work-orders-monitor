# Copy this file to .env. The tool reads .env each time it runs. Never commit .env.
# The values below work as they are with the commands in the README.

# --- Database (SQL Server) ---
# Check the connection with: uv run python -m swo_monitor.db
# Needs Microsoft's ODBC Driver 18: winget install Microsoft.msodbcsql.18
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost,1433
DB_NAME=NSWBuildingTakeHome
DB_USER=sa
# Must match MSSQL_SA_PASSWORD in the "docker run" command that started SQL Server.
# This is the README's example password. If you change it, change it in both places.
DB_PASSWORD=Str0ngLocalPass

# --- Email ---
# Send a test email with: uv run python -m swo_monitor.send_email

# --- Option 1: Mailpit (local test server, the default) ---
# Emails are caught and shown at http://localhost:8025. Nothing is really delivered.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=NONE
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=swo-monitor@example.com
EMAIL_TO=recipient@example.com

# --- Option 2: Gmail (real delivery) ---
# Needs 2-step verification and an app password: https://myaccount.google.com/apppasswords
# Other email providers work the same way, with their own host and port.
# To use it, comment out Option 1 above and uncomment these lines.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=STARTTLS
# SMTP_USERNAME=your.address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# EMAIL_FROM must be the same address as SMTP_USERNAME, or Gmail replaces it.
# EMAIL_FROM=your.address@gmail.com
# EMAIL_TO=where.to.send@example.com
